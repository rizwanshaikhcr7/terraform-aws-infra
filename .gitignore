# Local Terraform state (never commit this)
*.tfstate
*.tfstate.backup
*.tfstate.lock.info

# Terraform working directory
.terraform/
.terraform.lock.hcl

# Sensitive variable files (add your secrets here, not in tfvars)
*.tfvars.json
secrets.tfvars

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# macOS
.DS_Store

# Editor files
.vscode/
.idea/
*.swp
